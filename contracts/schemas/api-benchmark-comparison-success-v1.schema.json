          "type": "string"
        },
        "contract_version": {
          "const": "p0-funding-plan/1.0.0",
          "title": "Contract Version",
          "type": "string"
        },
        "data_version": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Data Version",
          "type": "string"
        },
        "fingerprint_verification": {
          "$ref": "#/$defs/FingerprintVerification"
        },
        "included_count": {
          "minimum": 0,
          "title": "Included Count",
          "type": "integer"
        },
        "included_governed_requests": {
          "items": {
            "$ref": "#/$defs/IncludedGovernedRequest"
          },
          "maxItems": 12,
          "title": "Included Governed Requests",
          "type": "array",
          "uniqueItems": true
        },
        "included_project_ids": {
          "items": {
            "enum": [
              "5282.043",
              "5789.075",
              "5789.107",
              "5789.121",
              "5789.126",
              "5789.136",
              "5789.139",
              "5789.141",
              "5789.145",
              "5789.146",
              "5789.150",
              "8598.014"
            ],
            "type": "string"
          },
          "maxItems": 12,
          "title": "Included Project Ids",
          "type": "array",
          "uniqueItems": true
        },
        "included_total_dollars": {
          "minimum": 0,
          "title": "Included Total Dollars",
          "type": "integer"
        },
        "not_included_active_family_project_ids": {
          "items": {
            "enum": [
              "5282.043",
              "5789.075",
              "5789.107",
              "5789.121",
              "5789.126",
              "5789.136",
              "5789.139",
              "5789.141",
              "5789.145",
              "5789.146",
              "5789.150",
              "8598.014"
            ],
            "type": "string"
          },
          "maxItems": 12,
          "title": "Not Included Active Family Project Ids",
          "type": "array",
          "uniqueItems": true
        },
        "overage_dollars": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Overage Dollars"
        },
        "plan_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Plan Fingerprint",
          "type": "string"
        },
        "remainder_dollars": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Remainder Dollars"
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/PlanWarning"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "contract_version",
        "data_version",
        "included_project_ids",
        "not_included_active_family_project_ids",
        "included_count",
        "included_governed_requests",
        "included_total_dollars",
        "available_budget_dollars",
        "remainder_dollars",
        "overage_dollars",
        "confirmation_status",
        "warnings",
        "plan_fingerprint",
        "fingerprint_verification"
      ],
      "title": "EvaluatedPlan",
      "type": "object"
    },
    "FingerprintVerification": {
      "additionalProperties": false,
      "properties": {
        "expected_fingerprint": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Fingerprint"
        },
        "matches": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Matches"
        }
      },
      "title": "FingerprintVerification",
      "type": "object"
    },
    "IncludedGovernedRequest": {
