{
  "$defs": {
    "Availability": {
      "enum": [
        "AVAILABLE",
        "MISSING",
        "UNSUPPORTED",
        "NOT_APPLICABLE",
        "NOT_EVALUATED_FIXTURE"
      ],
      "title": "Availability",
      "type": "string"
    },
    "BenchmarkComparisonResponseData": {
      "additionalProperties": false,
      "properties": {
        "benchmark_contract_version": {
          "const": "p0-benchmark/1.0.0",
          "title": "Benchmark Contract Version",
          "type": "string"
        },
        "benchmark_data_version": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Benchmark Data Version",
          "type": "string"
        },
        "benchmark_source_id": {
          "const": "austin_2026_bond_initial_draft_2026_01_21",
          "title": "Benchmark Source Id",
          "type": "string"
        },
        "city_included_count": {
          "$ref": "#/$defs/PublishedCountValue"
        },
        "documented_divergences": {
          "items": {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Documented Divergences",
          "type": "array"
        },
        "evaluated_plan": {
          "$ref": "#/$defs/EvaluatedPlan"
        },
        "overlap": {
          "anyOf": [
            {
              "$ref": "#/$defs/BenchmarkOverlap"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "published_allocation": {
          "$ref": "#/$defs/PublishedMoneyValue"
        }
      },
      "required": [
        "benchmark_contract_version",
        "benchmark_data_version",
        "benchmark_source_id",
        "evaluated_plan",
        "published_allocation",
        "city_included_count",
        "documented_divergences"
      ],
      "title": "BenchmarkComparisonResponseData",
      "type": "object"
    },
    "BenchmarkOverlap": {
      "additionalProperties": false,
      "properties": {
        "project_count": {
          "minimum": 0,
          "title": "Project Count",
          "type": "integer"
        },
        "project_ids": {
          "items": {
            "enum": [
              "5282.043",
              "5789.075",
              "5789.107",
              "5789.121",
              "5789.126",
              "5789.136",
              "5789.139",
              "5789.141",
              "5789.145",
              "5789.146",
              "5789.150",
              "8598.014"
            ],
            "type": "string"
          },
          "maxItems": 12,
          "title": "Project Ids",
          "type": "array",
          "uniqueItems": true
        },
        "published_amount": {
          "$ref": "#/$defs/PublishedMoneyValue"
        }
      },
      "required": [
        "project_ids",
        "project_count",
        "published_amount"
      ],
      "title": "BenchmarkOverlap",
      "type": "object"
    },
    "EvaluatedPlan": {
      "additionalProperties": false,
      "properties": {
        "available_budget_dollars": {
          "maximum": 1000000000,
          "minimum": 0,
          "title": "Available Budget Dollars",
          "type": "integer"
        },
        "confirmation_status": {
          "enum": [
            "VALID",
            "OVER_BUDGET"
          ],
