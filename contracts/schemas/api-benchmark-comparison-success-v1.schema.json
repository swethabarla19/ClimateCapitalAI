                "const": "5789.139"
              }
            },
            "required": [
              "project_id"
            ]
          },
          "then": {
            "properties": {
              "governed_request_dollars": {
                "const": 11250000
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "project_id": {
                "const": "5789.141"
              }
            },
            "required": [
              "project_id"
            ]
          },
          "then": {
            "properties": {
              "governed_request_dollars": {
                "const": 7350000
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "project_id": {
                "const": "5789.145"
              }
            },
            "required": [
              "project_id"
            ]
          },
          "then": {
            "properties": {
              "governed_request_dollars": {
                "const": 20000000
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "project_id": {
                "const": "5789.146"
              }
            },
            "required": [
              "project_id"
            ]
          },
          "then": {
            "properties": {
              "governed_request_dollars": {
                "const": 4450000
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "project_id": {
                "const": "5789.150"
              }
            },
            "required": [
              "project_id"
            ]
          },
          "then": {
            "properties": {
              "governed_request_dollars": {
                "const": 3000000
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "project_id": {
                "const": "8598.014"
              }
            },
            "required": [
              "project_id"
            ]
          },
          "then": {
            "properties": {
              "governed_request_dollars": {
                "const": 1500000
              }
            }
          }
        }
      ],
      "properties": {
        "governed_request_dollars": {
          "exclusiveMinimum": 0,
          "title": "Governed Request Dollars",
          "type": "integer"
        },
        "project_id": {
          "enum": [
            "5282.043",
            "5789.075",
            "5789.107",
            "5789.121",
            "5789.126",
            "5789.136",
            "5789.139",
            "5789.141",
            "5789.145",
            "5789.146",
            "5789.150",
            "8598.014"
          ],
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "governed_request_dollars"
      ],
      "title": "IncludedGovernedRequest",
      "type": "object"
    },
    "PlanWarning": {
      "additionalProperties": false,
      "properties": {
        "evidence_context_only": {
          "const": true,
          "title": "Evidence Context Only",
          "type": "boolean"
        },
        "message": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "project_id": {
          "anyOf": [
            {
              "pattern": "^[0-9]+\\.[0-9]{3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Project Id"
        },
        "warning_code": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,199}$",
          "title": "Warning Code",
          "type": "string"
        }
      },
      "required": [
        "warning_code",
        "project_id",
        "message",
        "evidence_context_only"
      ],
      "title": "PlanWarning",
      "type": "object"
    },
    "PublishedCountValue": {
      "additionalProperties": false,
      "properties": {
        "availability": {
          "$ref": "#/$defs/Availability"
        },
        "explanation": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "reason_code": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,199}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason Code"
        },
        "value": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "availability",
        "explanation"
      ],
      "title": "PublishedCountValue",
      "type": "object"
    },
    "PublishedMoneyValue": {
      "additionalProperties": false,
      "properties": {
        "availability": {
          "$ref": "#/$defs/Availability"
        },
        "explanation": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "reason_code": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,199}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason Code"
        },
        "source_text": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Text"
        },
        "unit": {
          "const": "USD",
          "title": "Unit",
          "type": "string"
        },
        "value_dollars": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value Dollars"
        }
      },
      "required": [
        "availability",
        "unit",
        "explanation"
      ],
      "title": "PublishedMoneyValue",
      "type": "object"
    },
    "ResponseIdentity": {
      "additionalProperties": false,
      "properties": {
        "api_namespace": {
          "const": "/api/v1",
          "title": "Api Namespace",
          "type": "string"
        },
        "contract_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Contract Version"
        },
        "data_version": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Data Version",
          "type": "string"
        },
        "release_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Release Id",
          "type": "string"
        },
        "request_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Request Id",
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "api_namespace",
        "data_version",
        "release_id"
      ],
      "title": "ResponseIdentity",
      "type": "object"
    }
  },
  "$id": "https://climatecapital.ai/contracts/schemas/api-benchmark-comparison-success-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "data": {
      "$ref": "#/$defs/BenchmarkComparisonResponseData"
    },
    "endpoint": {
      "const": "/api/v1/benchmark/compare",
      "title": "Endpoint",
      "type": "string"
    },
    "identity": {
      "$ref": "#/$defs/ResponseIdentity"
    },
    "status": {
      "const": "SUCCESS",
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "endpoint",
    "status",
    "identity",
    "data"
  ],
  "title": "BenchmarkComparisonSuccessEnvelope",
  "type": "object"
}
