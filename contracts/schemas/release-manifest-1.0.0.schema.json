          "type": "string"
        },
        "extractor": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,199}$",
          "title": "Extractor",
          "type": "string"
        },
        "geometry": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,199}$",
          "title": "Geometry",
          "type": "string"
        },
        "join": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,199}$",
          "title": "Join",
          "type": "string"
        },
        "serializer": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,199}$",
          "title": "Serializer",
          "type": "string"
        }
      },
      "required": [
        "extractor",
        "join",
        "geometry",
        "classification",
        "serializer"
      ],
      "title": "TransformationVersions",
      "type": "object"
    }
  },
