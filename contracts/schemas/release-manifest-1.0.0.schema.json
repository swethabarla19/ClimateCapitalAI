    "ManifestBenchmarkIdentity": {
      "additionalProperties": false,
      "properties": {
        "artifact_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Artifact Sha256",
          "type": "string"
        },
        "benchmark_contract_version": {
          "const": "p0-benchmark/1.0.0",
          "title": "Benchmark Contract Version",
          "type": "string"
        },
        "extraction_version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,199}$",
          "title": "Extraction Version",
          "type": "string"
        },
        "published_date": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "title": "Published Date",
          "type": "string"
        },
        "published_title": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Published Title",
          "type": "string"
        },
        "source_id": {
          "const": "austin_2026_bond_initial_draft_2026_01_21",
          "title": "Source Id",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "published_title",
        "published_date",
        "extraction_version",
        "benchmark_contract_version",
        "artifact_sha256"
      ],
      "title": "ManifestBenchmarkIdentity",
      "type": "object"
    },
    "ReleaseTier": {
      "enum": [
        "FIXTURE",
        "REVIEWED_RELEASE"
      ],
      "title": "ReleaseTier",
      "type": "string"
    },
    "SourceReference": {
      "additionalProperties": false,
      "properties": {
        "attribution_text": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Attribution Text",
          "type": "string"
        },
        "byte_size": {
          "exclusiveMinimum": 0,
          "title": "Byte Size",
          "type": "integer"
        },
        "gcs_object": {
          "anyOf": [
            {
              "$ref": "#/$defs/GcsObject"
            },
            {
              "type": "null"
            }
          ]
        },
        "historical_fit": {
          "$ref": "#/$defs/HistoricalFit"
        },
        "known_limitations": {
          "items": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Known Limitations",
          "type": "array"
        },
        "license_reuse_status": {
          "$ref": "#/$defs/LicenseReuseStatus"
        },
        "published_date": {
          "anyOf": [
            {
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published Date"
        },
        "publisher": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Publisher",
          "type": "string"
        },
        "retrieval_timestamp": {
          "anyOf": [
            {
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retrieval Timestamp"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "source_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,199}$",
          "title": "Source Id",
          "type": "string"
        },
        "source_url": {
          "pattern": "^https://[^\\s]+$",
          "title": "Source Url",
          "type": "string"
        },
        "source_vintage": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Source Vintage",
          "type": "string"
        },
        "title": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "publisher",
        "title",
        "source_url",
        "source_vintage",
        "sha256",
        "byte_size",
        "gcs_object",
        "historical_fit",
        "license_reuse_status",
        "attribution_text",
        "known_limitations"
      ],
      "title": "SourceReference",
      "type": "object"
    },
    "TransformationVersions": {
      "additionalProperties": false,
      "properties": {
        "classification": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,199}$",
