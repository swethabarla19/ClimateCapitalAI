{
  "$defs": {
    "ArtifactIdentities": {
      "additionalProperties": false,
      "properties": {
        "benchmark.json": {
          "$ref": "#/$defs/ArtifactIdentity"
        },
        "catalog.json": {
          "$ref": "#/$defs/ArtifactIdentity"
        },
        "map-context.geojson": {
          "$ref": "#/$defs/ArtifactIdentity"
        }
      },
      "required": [
        "catalog.json",
        "map-context.geojson",
        "benchmark.json"
      ],
      "title": "ArtifactIdentities",
      "type": "object"
    },
    "ArtifactIdentity": {
      "additionalProperties": false,
      "properties": {
        "byte_size": {
          "exclusiveMinimum": 0,
          "title": "Byte Size",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "sha256",
        "byte_size"
      ],
      "title": "ArtifactIdentity",
      "type": "object"
    },
    "ContractVersionSet": {
      "additionalProperties": false,
      "properties": {
        "benchmark": {
          "const": "p0-benchmark/1.0.0",
          "title": "Benchmark",
          "type": "string"
        },
        "browser_session": {
          "const": "p0-browser-session/1.0.0",
          "title": "Browser Session",
          "type": "string"
        },
        "catalog": {
          "const": "p0-catalog/1.0.0",
          "title": "Catalog",
          "type": "string"
        },
        "funding_plan": {
          "const": "p0-funding-plan/1.0.0",
          "title": "Funding Plan",
          "type": "string"
        },
        "gemini_explain": {
          "const": "p0-gemini-explain/1.0.0",
          "title": "Gemini Explain",
          "type": "string"
        },
        "map_context": {
          "const": "p0-map-context/1.0.0",
          "title": "Map Context",
          "type": "string"
        }
      },
      "required": [
        "catalog",
        "map_context",
        "benchmark",
        "funding_plan",
        "browser_session",
        "gemini_explain"
      ],
      "title": "ContractVersionSet",
      "type": "object"
    },
    "EvidenceCoverageMissingness": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "evidence_type": {
                "const": "GOVERNED_PROJECT_IDENTITY"
              }
            },
            "required": [
              "evidence_type"
            ]
          },
          "then": {
            "properties": {
              "evidence_role": {
                "const": "FACT"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "evidence_type": {
                "const": "GOVERNED_REQUEST"
              }
            },
            "required": [
              "evidence_type"
            ]
          },
          "then": {
            "properties": {
              "evidence_role": {
                "const": "FACT"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "evidence_type": {
                "const": "DERIVED_PURPOSE"
              }
            },
            "required": [
              "evidence_type"
            ]
          },
          "then": {
            "properties": {
              "evidence_role": {
                "const": "FACT"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "evidence_type": {
                "const": "P0_FAMILY"
              }
            },
            "required": [
              "evidence_type"
            ]
          },
          "then": {
            "properties": {
              "evidence_role": {
                "const": "FACT"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "evidence_type": {
                "const": "PROBLEM_SCORE_ASSOCIATION"
              }
            },
            "required": [
              "evidence_type"
            ]
          },
          "then": {
            "properties": {
              "evidence_role": {
                "const": "CONTEXTUAL_EVIDENCE"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "evidence_type": {
                "const": "RNA_DISPLAY_GEOMETRY_AVAILABILITY"
              }
            },
            "required": [
              "evidence_type"
            ]
          },
          "then": {
            "properties": {
              "evidence_role": {
                "const": "RESEARCH_ONLY_EVIDENCE"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "evidence_type": {
                "const": "FEMA_CURRENT_HAZARD_CONTEXT"
              }
            },
            "required": [
              "evidence_type"
            ]
          },
          "then": {
            "properties": {
              "evidence_role": {
                "const": "CONTEXTUAL_EVIDENCE"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "evidence_type": {
                "const": "EAZ_2021_CONTEXT"
              }
            },
            "required": [
              "evidence_type"
            ]
          },
          "then": {
            "properties": {
              "evidence_role": {
                "const": "CONTEXTUAL_EVIDENCE"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "evidence_type": {
                "const": "EXPECTED_FLOOD_REDUCTION_BENEFIT"
              }
            },
            "required": [
              "evidence_type"
            ]
          },
          "then": {
            "properties": {
              "evidence_role": {
                "const": "UNAVAILABLE_UNSUPPORTED"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "evidence_type": {
                "const": "BENEFICIARY_ESTIMATES"
              }
            },
            "required": [
              "evidence_type"
            ]
          },
          "then": {
            "properties": {
              "evidence_role": {
                "const": "UNAVAILABLE_UNSUPPORTED"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "scope": {
                "const": "GOVERNED_UNIVERSE"
              }
            },
            "required": [
              "scope"
            ]
          },
          "then": {
            "properties": {
              "denominator": {
                "const": 37
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "scope": {
                "const": "ACTIVE_FAMILY"
              }
            },
            "required": [
              "scope"
            ]
          },
          "then": {
            "properties": {
              "denominator": {
                "const": 12
              }
            }
          }
        }
      ],
      "properties": {
        "available_count": {
          "minimum": 0,
          "title": "Available Count",
          "type": "integer"
        },
        "denominator": {
          "minimum": 0,
          "title": "Denominator",
          "type": "integer"
        },
        "evidence_role": {
          "$ref": "#/$defs/EvidenceRole"
        },
        "evidence_type": {
          "$ref": "#/$defs/EvidenceType"
        },
        "fixture_state_count": {
          "minimum": 0,
          "title": "Fixture State Count",
          "type": "integer"
        },
        "missing_count": {
          "minimum": 0,
          "title": "Missing Count",
          "type": "integer"
        },
        "not_applicable_count": {
          "minimum": 0,
          "title": "Not Applicable Count",
          "type": "integer"
        },
        "scope": {
          "enum": [
            "GOVERNED_UNIVERSE",
            "ACTIVE_FAMILY"
          ],
          "title": "Scope",
          "type": "string"
        },
        "unsupported_count": {
          "minimum": 0,
          "title": "Unsupported Count",
          "type": "integer"
        }
      },
      "required": [
        "evidence_type",
        "evidence_role",
        "scope",
        "denominator",
        "available_count",
        "missing_count",
        "unsupported_count",
        "not_applicable_count",
        "fixture_state_count"
      ],
      "title": "EvidenceCoverageMissingness",
      "type": "object"
    },
    "EvidenceRole": {
      "enum": [
        "FACT",
        "CONTEXTUAL_EVIDENCE",
        "RESEARCH_ONLY_EVIDENCE",
        "UNAVAILABLE_UNSUPPORTED"
      ],
      "title": "EvidenceRole",
      "type": "string"
    },
    "EvidenceType": {
      "enum": [
        "GOVERNED_PROJECT_IDENTITY",
        "GOVERNED_REQUEST",
        "DERIVED_PURPOSE",
        "P0_FAMILY",
        "PROBLEM_SCORE_ASSOCIATION",
        "RNA_DISPLAY_GEOMETRY_AVAILABILITY",
        "FEMA_CURRENT_HAZARD_CONTEXT",
        "EAZ_2021_CONTEXT",
        "EXPECTED_FLOOD_REDUCTION_BENEFIT",
        "BENEFICIARY_ESTIMATES"
      ],
      "title": "EvidenceType",
      "type": "string"
    },
    "GcsObject": {
      "additionalProperties": false,
      "properties": {
        "byte_size": {
          "exclusiveMinimum": 0,
          "title": "Byte Size",
          "type": "integer"
        },
        "generation": {
          "pattern": "^[1-9][0-9]*$",
          "title": "Generation",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "uri": {
          "pattern": "^gs://[^/]+/.+$",
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "uri",
        "generation",
        "sha256",
        "byte_size"
      ],
      "title": "GcsObject",
      "type": "object"
    },
