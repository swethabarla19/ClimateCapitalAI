{
  "$defs": {
    "Availability": {
      "enum": [
        "AVAILABLE",
        "MISSING",
        "UNSUPPORTED",
        "NOT_APPLICABLE",
        "NOT_EVALUATED_FIXTURE"
      ],
      "title": "Availability",
      "type": "string"
    },
    "BenchmarkArtifact": {
      "additionalProperties": false,
      "properties": {
        "benchmark_identity": {
          "$ref": "#/$defs/BenchmarkPublishedIdentity"
        },
        "contract_version": {
          "const": "p0-benchmark/1.0.0",
          "title": "Contract Version",
          "type": "string"
        },
        "data_version": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Data Version",
          "type": "string"
        },
        "limitations": {
          "items": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Limitations",
          "type": "array"
        },
        "published_portfolio_summary": {
          "$ref": "#/$defs/PublishedPortfolioSummary"
        },
        "published_project_treatments": {
          "items": {
            "$ref": "#/$defs/PublishedProjectTreatment"
          },
          "title": "Published Project Treatments",
          "type": "array"
        },
        "reconciliation": {
          "$ref": "#/$defs/BenchmarkReconciliation"
        },
        "release_tier": {
          "$ref": "#/$defs/ReleaseTier"
        },
        "source_references": {
          "additionalProperties": false,
          "patternProperties": {
            "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,199}$": {
              "$ref": "#/$defs/SourceReference"
            }
          },
          "title": "Source References",
          "type": "object"
        },
        "transformation_version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,199}$",
          "title": "Transformation Version",
          "type": "string"
        }
      },
      "required": [
        "contract_version",
        "data_version",
        "release_tier",
        "benchmark_identity",
        "source_references",
        "published_portfolio_summary",
        "published_project_treatments",
        "transformation_version",
        "limitations",
        "reconciliation"
      ],
      "title": "BenchmarkArtifact",
      "type": "object"
    },
    "BenchmarkPublishedIdentity": {
      "additionalProperties": false,
      "properties": {
        "extraction_version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,199}$",
          "title": "Extraction Version",
          "type": "string"
        },
        "published_date": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "title": "Published Date",
          "type": "string"
        },
        "published_title": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Published Title",
          "type": "string"
        },
        "source_id": {
          "const": "austin_2026_bond_initial_draft_2026_01_21",
          "title": "Source Id",
          "type": "string"
        },
        "source_snapshot_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Snapshot Sha256",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "published_title",
        "published_date",
        "source_snapshot_sha256",
        "extraction_version"
      ],
      "title": "BenchmarkPublishedIdentity",
      "type": "object"
    },
    "BenchmarkReconciliation": {
      "additionalProperties": false,
      "properties": {
        "available_amount_total_dollars": {
          "minimum": 0,
          "title": "Available Amount Total Dollars",
          "type": "integer"
        },
        "entry_count": {
          "minimum": 0,
          "title": "Entry Count",
          "type": "integer"
        },
        "explanation": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "publication_reconciliation_passed": {
          "const": true,
          "title": "Publication Reconciliation Passed",
          "type": "boolean"
        }
      },
      "required": [
        "entry_count",
        "available_amount_total_dollars",
        "publication_reconciliation_passed",
        "explanation"
      ],
      "title": "BenchmarkReconciliation",
      "type": "object"
    },
    "BenchmarkResponseData": {
      "additionalProperties": false,
      "properties": {
        "benchmark": {
          "$ref": "#/$defs/BenchmarkArtifact"
        },
        "deployment_identity": {
          "$ref": "#/$defs/DeploymentIdentityData"
        }
      },
      "required": [
        "benchmark",
        "deployment_identity"
      ],
      "title": "BenchmarkResponseData",
      "type": "object"
    },
    "DeploymentIdentityData": {
      "additionalProperties": false,
      "properties": {
        "code_git_sha": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Code Git Sha",
          "type": "string"
        },
        "container_image_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Container Image Digest",
          "type": "string"
        },
        "manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest Sha256",
          "type": "string"
        },
        "release_tier": {
          "$ref": "#/$defs/ReleaseTier"
        }
      },
      "required": [
        "code_git_sha",
        "manifest_sha256",
        "container_image_digest",
        "release_tier"
      ],
      "title": "DeploymentIdentityData",
      "type": "object"
    },
    "GcsObject": {
      "additionalProperties": false,
      "properties": {
        "byte_size": {
          "exclusiveMinimum": 0,
          "title": "Byte Size",
          "type": "integer"
        },
        "generation": {
          "pattern": "^[1-9][0-9]*$",
          "title": "Generation",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "uri": {
          "pattern": "^gs://[^/]+/.+$",
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "uri",
        "generation",
        "sha256",
        "byte_size"
      ],
      "title": "GcsObject",
      "type": "object"
    },
    "HistoricalFit": {
      "enum": [
        "HISTORICALLY_VALID",
        "CURRENT_CONTEXT_ONLY",
        "HISTORICAL_FIT_UNCERTAIN",
        "NOT_APPLICABLE"
      ],
      "title": "HistoricalFit",
      "type": "string"
    },
    "LicenseReuseStatus": {
      "enum": [
        "VERIFIED",
        "UNVERIFIED",
        "RESTRICTED",
        "NOT_APPLICABLE"
      ],
      "title": "LicenseReuseStatus",
      "type": "string"
    },
    "PublishedCountValue": {
      "additionalProperties": false,
      "properties": {
        "availability": {
          "$ref": "#/$defs/Availability"
        },
        "explanation": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "reason_code": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,199}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason Code"
        },
        "value": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "availability",
        "explanation"
      ],
      "title": "PublishedCountValue",
      "type": "object"
    },
    "PublishedMoneyValue": {
      "additionalProperties": false,
      "properties": {
        "availability": {
          "$ref": "#/$defs/Availability"
        },
        "explanation": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "reason_code": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,199}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason Code"
        },
        "source_text": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Text"
        },
        "unit": {
          "const": "USD",
          "title": "Unit",
          "type": "string"
        },
        "value_dollars": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value Dollars"
        }
      },
      "required": [
        "availability",
        "unit",
        "explanation"
      ],
      "title": "PublishedMoneyValue",
      "type": "object"
    },
    "PublishedPortfolioSummary": {
      "additionalProperties": false,
      "properties": {
        "city_included_count": {
          "$ref": "#/$defs/PublishedCountValue"
        },
        "explanation": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "published_allocation": {
          "$ref": "#/$defs/PublishedMoneyValue"
        }
      },
      "required": [
        "published_allocation",
        "city_included_count",
        "explanation"
      ],
      "title": "PublishedPortfolioSummary",
      "type": "object"
    },
    "PublishedProjectTreatment": {
      "additionalProperties": false,
      "properties": {
        "city_treatment": {
          "$ref": "#/$defs/PublishedTreatmentValue"
        },
        "entry_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,199}$",
          "title": "Entry Id",
          "type": "string"
        },
        "governed_project_id": {
          "anyOf": [
            {
              "pattern": "^[0-9]+\\.[0-9]{3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Governed Project Id"
        },
        "limitations": {
          "items": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Limitations",
          "type": "array"
        },
        "published_amount": {
          "$ref": "#/$defs/PublishedMoneyValue"
        },
        "published_project_name": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Published Project Name",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,199}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Ids",
          "type": "array"
        }
      },
      "required": [
        "entry_id",
        "published_project_name",
        "city_treatment",
        "published_amount",
        "source_ids",
        "limitations"
      ],
      "title": "PublishedProjectTreatment",
      "type": "object"
    },
    "PublishedTreatmentValue": {
      "additionalProperties": false,
      "properties": {
        "availability": {
          "$ref": "#/$defs/Availability"
        },
        "explanation": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "reason_code": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,199}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason Code"
        },
        "value": {
          "anyOf": [
            {
              "enum": [
                "HISTORICALLY_RECOMMENDED",
                "NOT_HISTORICALLY_RECOMMENDED",
                "CITY_INCLUDED",
                "NOT_CITY_INCLUDED",
                "OTHER_PUBLISHED_TREATMENT"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "availability",
        "explanation"
      ],
      "title": "PublishedTreatmentValue",
      "type": "object"
    },
    "ReleaseTier": {
      "enum": [
        "FIXTURE",
        "REVIEWED_RELEASE"
      ],
      "title": "ReleaseTier",
      "type": "string"
    },
    "ResponseIdentity": {
      "additionalProperties": false,
      "properties": {
        "api_namespace": {
          "const": "/api/v1",
          "title": "Api Namespace",
          "type": "string"
        },
        "contract_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Contract Version"
        },
        "data_version": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Data Version",
          "type": "string"
        },
        "release_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Release Id",
          "type": "string"
        },
        "request_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Request Id",
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "api_namespace",
        "data_version",
        "release_id"
      ],
      "title": "ResponseIdentity",
      "type": "object"
    },
    "SourceReference": {
      "additionalProperties": false,
      "properties": {
        "attribution_text": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Attribution Text",
          "type": "string"
        },
        "byte_size": {
          "exclusiveMinimum": 0,
          "title": "Byte Size",
          "type": "integer"
        },
        "gcs_object": {
          "anyOf": [
            {
              "$ref": "#/$defs/GcsObject"
            },
            {
              "type": "null"
            }
          ]
        },
        "historical_fit": {
          "$ref": "#/$defs/HistoricalFit"
        },
        "known_limitations": {
          "items": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Known Limitations",
          "type": "array"
        },
        "license_reuse_status": {
          "$ref": "#/$defs/LicenseReuseStatus"
        },
        "published_date": {
          "anyOf": [
            {
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published Date"
        },
        "publisher": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Publisher",
          "type": "string"
        },
        "retrieval_timestamp": {
          "anyOf": [
            {
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retrieval Timestamp"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "source_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,199}$",
          "title": "Source Id",
          "type": "string"
        },
        "source_url": {
          "pattern": "^https://[^\\s]+$",
          "title": "Source Url",
          "type": "string"
        },
        "source_vintage": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Source Vintage",
          "type": "string"
        },
        "title": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "publisher",
        "title",
        "source_url",
        "source_vintage",
        "sha256",
        "byte_size",
        "gcs_object",
        "historical_fit",
        "license_reuse_status",
        "attribution_text",
        "known_limitations"
      ],
      "title": "SourceReference",
      "type": "object"
    }
  },
  "$id": "https://climatecapital.ai/contracts/schemas/api-benchmark-success-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "data": {
      "$ref": "#/$defs/BenchmarkResponseData"
    },
    "endpoint": {
      "const": "/api/v1/benchmark",
      "title": "Endpoint",
      "type": "string"
    },
    "identity": {
      "$ref": "#/$defs/ResponseIdentity"
    },
    "status": {
      "const": "SUCCESS",
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "endpoint",
    "status",
    "identity",
    "data"
  ],
  "title": "BenchmarkSuccessEnvelope",
  "type": "object"
}
